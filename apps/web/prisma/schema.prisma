generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                    @id @default(cuid())
  name               String
  email              String                    @unique
  passwordHash       String?
  emailVerifiedAt    DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  patients           Patient[]
  financialProfiles  PatientFinancialProfile[]
  appointments       Appointment[]
  notifications      NotificationAttempt[]
  sessions           Session[]
  uiPreference       UserUiPreference?
  financeEntries     FinanceEntry[]
  financeEntryEvents FinanceEntryEvent[]
  authTokens         AuthToken[]
  oauthAccounts      OAuthAccount[]
  clinicalAnamneses  ClinicalAnamnesis[]
  clinicalEvolutions ClinicalEvolution[]
  googleCalendar     GoogleCalendarConnection?
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     String
  kind       String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserUiPreference {
  id                    String    @id @default(cuid())
  userId                String    @unique
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  dashboardSectionOrder Json?
  hideFinancialValues   Boolean   @default(false)
  dismissedNewsBannerAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum PatientStatus {
  ativo
  inativo
  arquivado
}

enum PaymentMethod {
  pix
  card
  cash
  insurance
}

enum AppointmentStatus {
  agendada
  confirmada
  realizada
  falta
  cancelada
  remarcada
  pendente
  recusada
}

enum NotificationChannel {
  whatsapp
}

enum NotificationStatus {
  pendente
  enviado
  falhou
}

model Patient {
  id                           String                   @id @default(cuid())
  userId                       String
  name                         String
  phone                        String
  normalizedPhone              String
  email                        String?
  cpf                          String?
  normalizedCpf                String?
  birthDate                    DateTime?
  notes                        String?
  chiefComplaint               String?
  whatsappConsent              Boolean                  @default(false)
  emailConsent                 Boolean                  @default(false)
  addressZipCode               String?
  addressStreet                String?
  addressNumber                String?
  addressComplement            String?
  addressCity                  String?
  addressState                 String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  status                       PatientStatus            @default(ativo)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  user                         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialProfile             PatientFinancialProfile?
  appointments                 Appointment[]
  notifications                NotificationAttempt[]
  financeEntries               FinanceEntry[]
  clinicalAnamnesis            ClinicalAnamnesis?
  clinicalEvolutions           ClinicalEvolution[]

  @@unique([userId, normalizedPhone])
  @@unique([userId, normalizedCpf])
  @@index([userId, status])
  @@index([userId, name])
}

model PatientFinancialProfile {
  id                         String        @id @default(cuid())
  userId                     String
  patientId                  String        @unique
  preferredPaymentMethod     PaymentMethod
  defaultSessionPriceCents   Int
  currency                   String        @default("BRL")
  pixKeyType                 String?
  pixKey                     String?
  cardProvider               String?
  cardPaymentMethodRef       String?
  cardBrand                  String?
  cardLast4                  String?
  cardHolderName             String?
  cardInstallments           Int?
  insuranceName              String?
  insuranceMemberId          String?
  insuranceAuthorizationInfo String?
  isComplete                 Boolean       @default(false)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  user                       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient                    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isComplete])
}

model Appointment {
  id                    String                @id @default(cuid())
  userId                String
  patientId             String
  startsAt              DateTime
  endsAt                DateTime
  type                  String                @default("Consulta")
  videoUrl              String?
  status                AppointmentStatus     @default(agendada)
  sessionStartedAt      DateTime?
  sessionEndedAt        DateTime?
  googleCalendarEventId String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient               Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  notifications         NotificationAttempt[]
  financeEntry          FinanceEntry?
  clinicalEvolution     ClinicalEvolution?

  @@index([userId, startsAt])
  @@index([patientId, startsAt])
}

model ClinicalAnamnesis {
  id                String   @id @default(cuid())
  userId            String
  patientId         String   @unique
  encryptedPayload  String
  encryptionVersion Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ClinicalEvolution {
  id                String       @id @default(cuid())
  userId            String
  patientId         String
  appointmentId     String?      @unique
  occurredAt        DateTime
  mood              Int
  encryptedPayload  String
  encryptionVersion Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient           Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, patientId, occurredAt])
}

model GoogleCalendarConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  googleAccountEmail    String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String
  expiresAt             DateTime?
  scope                 String
  calendarId            String    @default("primary")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FinanceEntryType {
  receita
  despesa
}

enum FinanceEntryStatus {
  previsto
  efetivado
  cancelado
}

enum FinanceEntryOrigin {
  appointment
  manual
}

enum FinanceEntryEventType {
  created
  updated
  effected
  canceled
}

model FinanceEntry {
  id            String              @id @default(cuid())
  userId        String
  patientId     String?
  appointmentId String?             @unique
  type          FinanceEntryType
  status        FinanceEntryStatus  @default(previsto)
  origin        FinanceEntryOrigin
  description   String
  category      String
  paymentMethod PaymentMethod?
  valueCents    Int
  date          DateTime
  dueDate       DateTime
  effectiveAt   DateTime?
  canceledAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient       Patient?            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  events        FinanceEntryEvent[]

  @@index([userId, date])
  @@index([userId, type, status])
  @@index([patientId, date])
}

model FinanceEntryEvent {
  id          String                @id @default(cuid())
  userId      String
  entryId     String
  type        FinanceEntryEventType
  beforeState Json?
  afterState  Json
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry       FinanceEntry          @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@index([userId, createdAt])
}

model NotificationAttempt {
  id                String              @id @default(cuid())
  userId            String
  patientId         String
  appointmentId     String
  channel           NotificationChannel @default(whatsapp)
  status            NotificationStatus  @default(pendente)
  recipientPhone    String
  provider          String              @default("twilio")
  providerMessageId String?
  failureReason     String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
}
