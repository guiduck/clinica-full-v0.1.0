# Porta usada somente entre o Caddy da VPS e o container.
# Porta 3101 confirmada como livre na VPS em 2026-09-01.
APP_PORT=3101

# Banco PostgreSQL interno do Docker. Use valores fortes em producao.
# Para gerar valores seguros: openssl rand -hex 24
POSTGRES_DB=clinica_agil
POSTGRES_USER=clinica
POSTGRES_PASSWORD=COLOQUE_AQUI_UM_NOVO_HEX_ALEATORIO

# Dominio publico da aplicacao.
NEXT_PUBLIC_APP_URL=https://clinica-full.gfig.space
NEXT_PUBLIC_API_BASE_URL=https://clinica-full.gfig.space
NEXT_PUBLIC_SITE_URL=https://clinica-full.gfig.space

SESSION_COOKIE_NAME=clinica_session
SESSION_SECRET=COLOQUE_AQUI_OUTRO_NOVO_HEX_ALEATORIO

# O app funciona sem Twilio, mas o envio de WhatsApp ficara indisponivel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
