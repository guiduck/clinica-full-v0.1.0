# Banco PostgreSQL interno do Docker. Use valores fortes em producao.
# Para gerar valores seguros: openssl rand -hex 24
POSTGRES_DB=clinica_agil
POSTGRES_USER=clinica
POSTGRES_PASSWORD=1726892fa84a098e08576df53684ded667af5fc7c96e134f

# Troque pelo subdominio criado no DNS da Vercel.
NEXT_PUBLIC_APP_URL=https://clinica.seudominio.com
NEXT_PUBLIC_API_BASE_URL=https://clinica.seudominio.com
NEXT_PUBLIC_SITE_URL=https://clinica.seudominio.com

